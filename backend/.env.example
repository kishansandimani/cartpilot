# ---- Copy this file to ".env" and fill in your own values. NEVER commit ".env". ----

# REQUIRED: long random string used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

DATABASE_URL=sqlite:///./cartpilot.db
CORS_ORIGINS=http://localhost:5173

# Gemini (https://aistudio.google.com/apikey) - needed for the AI assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Product discovery: "channel3" (real, needs key) or "fixtures" (clearly-labelled DEV data)
PRODUCT_PROVIDER=channel3
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com
# Currency the product provider returns prices in (Channel3 is USD-centric; check your plan)
PRODUCT_CURRENCY=USD
# Optional: if you set this, rupee budgets ("under Rs 60000") are converted to USD for search.
# Leave blank and CartPilot will NOT guess an exchange rate.
INR_PER_USD=

# PayPal (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Must be a currency your PayPal merchant account supports. INR is restricted by PayPal, so USD for sandbox.
PAYPAL_CURRENCY=USD

# Key used to encrypt third-party tokens stored in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
